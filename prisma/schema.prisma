// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model BlogPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        String[]
  slug        String   @unique
  image       String?
  isAI        Boolean? @default(false)

  @@map("blog_posts")
}

model TutorialPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        String[]
  difficulty  String?
  slug        String   @unique

  @@map("tutorial_posts")
}

model Comment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  authorId     String?  @db.ObjectId
  authorName   String?
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  postSlug     String
  replyingToId String?

  @@map("comments")
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  password     String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessionToken String?   @unique @db.ObjectId
  messages     Message[]

  thejoey Boolean? @default(false)

  // Profile Fields
  username          String? @unique
  bio               String? // Markdown supported
  website           String?
  twitter           String?
  github            String?
  linkedin          String?
  isProfileVerified Boolean @default(false)
  profileImage      String?

  // Streaks
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?

  // Gamification & Mini-games additions
  lastLoginClaim   DateTime?
  gameEnergy       Int       @default(100)
  gameInventory    Json?     // Stores items like { fish: [], minerals: [], merged: [] }
  experience       Int       @default(0)

  CourseProgress CourseProgress[]
  LessonProgress LessonProgress[]

  badges UserBadge[]

  @@map("users")
}

model CourseProgress {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  userId         String?          @db.ObjectId
  completed      Boolean?         @default(false)
  courseSlug     String           @unique
  Course         Course?          @relation(fields: [courseSlug], references: [slug])
  User           User?            @relation(fields: [userId], references: [id])
  lessonProgress LessonProgress[]

  @@map("course_progress")
}

model LessonProgress {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  completed        Boolean?        @default(false)
  lessonSlug       String
  CourseProgress   CourseProgress? @relation(fields: [courseProgressId], references: [id])
  courseProgressId String?         @db.ObjectId
  Lesson           Lesson?         @relation(fields: [lessonSlug], references: [slug])
  User             User?           @relation(fields: [userId], references: [id])
  userId           String?         @db.ObjectId

  @@unique([lessonSlug, courseProgressId])
  @@map("lesson_progress")
}

model Message {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  createdAt   DateTime @default(now())
  User        User?    @relation(fields: [userId], references: [id])
  userId      String?  @db.ObjectId

  @@map("messages")
}

model Course {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String
  lessons        Lesson[]
  tags           String[]
  slug           String           @unique
  progressional  Boolean
  userId         String?          @db.ObjectId
  order          String[]
  CourseProgress CourseProgress[]
  rating         Json? // Allow null values for the `rating` field
  duration       Int?

  @@map("courses")
}

model CourseTrack {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  slug        String   @unique
  courseSlugs String[] // Ordered list of course slugs in this track
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments CourseTrackEnrollment[]

  @@map("course_tracks")
}

model CourseTrackEnrollment {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  userId      String      @db.ObjectId
  trackSlug   String
  track       CourseTrack @relation(fields: [trackSlug], references: [slug])
  completed   Boolean     @default(false)
  startedAt   DateTime    @default(now())
  completedAt DateTime?

  @@unique([userId, trackSlug])
  @@map("course_track_enrollments")
}

model Exercise {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  question      String
  type          String
  options       String?
  correctAnswer String
  hint          String?
  Lesson        Lesson? @relation(fields: [lessonSlug], references: [slug])
  lessonSlug    String

  @@map("exercises")
}

model Lesson {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String
  content        String?
  exercises      Exercise[]
  slug           String           @unique
  courseSlug     String
  completed      Boolean?
  duration       Int?
  Course         Course           @relation(fields: [courseSlug], references: [slug])
  LessonProgress LessonProgress[]

  @@map("lessons")
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)

  @@map("contact_messages")
}

model ActivityLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  action      String
  description String?
  userId      String?  @db.ObjectId
  createdAt   DateTime @default(now())

  @@map("activity_logs")
}

model LessonFeedback {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  lessonSlug String
  feedback   String
  createdAt  DateTime @default(now())

  @@map("lesson_feedback")
}

model LessonNote {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  lessonSlug String
  content    String // Markdown content
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, lessonSlug])
  @@map("lesson_notes")
}

model Badge {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String
  icon        String // React icon name or URL
  criteria    Json // Store criteria like { type: "streak", count: 7 }
  createdAt   DateTime @default(now())

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String   @db.ObjectId
  badgeId  String   @db.ObjectId
  earnedAt DateTime @default(now())

  User  User  @relation(fields: [userId], references: [id])
  Badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@map("user_badges")
}
