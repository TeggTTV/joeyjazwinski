// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model BlogPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        String[]
  slug        String   @unique
  isAI        Boolean? @default(false)

  @@map("blog_posts")
}

model TutorialPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        String[]
  difficulty  String?
  slug        String   @unique

  @@map("tutorial_posts")
}

model Comment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  authorId     String?  @db.ObjectId
  authorName   String?
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  postSlug     String
  replyingToId String?

  @@map("comments")
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  password     String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessionToken String?   @unique @db.ObjectId
  messages     Message[]

  thejoey        Boolean?         @default(false)
  CourseProgress CourseProgress[]
  LessonProgress LessonProgress[]

  @@map("users")
}

model CourseProgress {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  userId         String?          @db.ObjectId
  completed      Boolean?         @default(false)
  courseSlug     String           @unique
  Course         Course?          @relation(fields: [courseSlug], references: [slug])
  User           User?            @relation(fields: [userId], references: [id])
  lessonProgress LessonProgress[]

  @@map("course_progress")
}

model LessonProgress {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  completed        Boolean?        @default(false)
  lessonSlug       String          @unique
  CourseProgress   CourseProgress? @relation(fields: [courseProgressId], references: [id])
  courseProgressId String?         @db.ObjectId
  Lesson           Lesson?         @relation(fields: [lessonSlug], references: [slug])
  User             User?           @relation(fields: [userId], references: [id])
  userId           String?         @db.ObjectId

  @@unique([lessonSlug, courseProgressId])
  @@map("lesson_progress")
}

model Message {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  createdAt   DateTime @default(now())
  User        User?    @relation(fields: [userId], references: [id])
  userId      String?  @db.ObjectId

  @@map("messages")
}

model Course {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String
  lessons        Lesson[]
  tags           String[]
  slug           String           @unique
  progressional  Boolean
  userId         String?          @db.ObjectId
  order          String[]
  CourseProgress CourseProgress[]
  rating         Int[]
  duration       Int?

  @@map("courses")
}

model Exercise {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  question      String
  type          String
  options       String?
  correctAnswer String
  hint          String?
  Lesson        Lesson? @relation(fields: [lessonSlug], references: [slug])
  lessonSlug    String

  @@map("exercises")
}

model Lesson {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String
  exercises      Exercise[]
  slug           String           @unique
  courseSlug     String
  completed      Boolean?
  duration       Int?
  Course         Course           @relation(fields: [courseSlug], references: [slug])
  LessonProgress LessonProgress[]

  @@map("lessons")
}
