// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model BlogPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        String[]
  slug        String   @unique

  @@map("blog_posts")
}

model TutorialPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        String[]
  difficulty  String?
  slug        String   @unique

  @@map("tutorial_posts")
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  postId    String

  @@map("comments")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  password     String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessionToken String?  @unique
  courses      Course[] @relation("UserCourses")
  thejoey      Boolean? @default(false)

  @@map("users")
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@map("messages")
}

model Course {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String
  lessons       Lesson[]
  tags          String[]
  slug          String   @unique
  progressional Boolean
  userId        String?  @db.ObjectId
  User          User?    @relation("UserCourses", fields: [userId], references: [id])
  order         String[]

  @@map("courses")
}

model Exercise {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  question      String
  type          String
  options       String?
  correctAnswer String
  hint          String?
  Lesson        Lesson? @relation(fields: [lessonSlug], references: [slug])
  lessonSlug    String

  @@map("exercises")
}

model Lesson {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  exercises   Exercise[]
  slug        String     @unique
  courseSlug  String
  completed   Boolean?
  duration    Int?
  Course      Course     @relation(fields: [courseSlug], references: [slug])

  @@map("lessons")
}
